# ==========================================
# FloodGuard AI — Environment Configuration
# ==========================================

# Google Gemini API Key (Required for live Copilot AI reasoning)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# In Vercel, add this under Project Settings -> Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External API endpoint
# On Vercel, leave empty to use Next.js built-in serverless App Router API routes (/api)
# NEXT_PUBLIC_API_URL=

# ==========================================
# FloodGuard AI — Environment Configuration
# ==========================================

# Google Gemini API Key (Required for live Copilot AI reasoning)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# In Vercel, configure this under: Project Settings -> Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Next.js Frontend Configuration
# On Vercel deployments, leave NEXT_PUBLIC_API_URL blank to default to Next.js serverless API routes (/api)
# For local dual-stack development with FastAPI:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=

# Backend Python Server (Optional for standalone Next.js deployment)
DATABASE_URL=postgresql://mayankgautam@localhost:5432/floodguard
HOST=0.0.0.0
PORT=8000
DEBUG=False
